# Default Application Configuration
DEBUG=false
LOCAL_TIMEZONE="Europe/London"

# Authentication credentials for Playwright to use during the Amazon login flow
LOGIN_EMAIL="your_email@example.com"
LOGIN_PASSWORD="your_password"
OTP_SECRET_KEY="YOUR_2FA_SECRET_KEY"

# The login endpoint
LOGIN_URL="https://sellercentral.amazon.co.uk/ap/signin"

# The target dashboard that Playwright lands on to verify authentication
TARGET_URL="https://sellercentral.amazon.co.uk/snowdash/ref=xx_shopdash_dnav_xx"

# Google Chat Webhook URL for posting summary cards
CHAT_WEBHOOK_URL="https://chat.googleapis.com/v1/spaces/..."
CHAT_BATCH_SIZE=100

# Google Forms endpoint for normalized submissions
FORM_POST_URL="https://docs.google.com/forms/d/e/1FAIpQLSefktpkvAEYtT8pgYknAdWH_GmopNb-QLrmtTS-ijrBTc1hew/formResponse"

# Concurrency limitations for Playwright instances
INITIAL_CONCURRENCY=5
NUM_FORM_SUBMITTERS=2
DROPDOWN_REFRESH_MAX_AGE_DAYS=7
FORCE_DROPDOWN_DISCOVERY=false
WORKER_RETRY_COUNT=3
FAST_PATH_MAX_CONCURRENCY=12
FAST_PATH_WARMUP_REQUESTS=4
FAST_PATH_WARMUP_DELAY_MS=150
FAST_PATH_RETRY_COUNT=3
FAST_PATH_RETRY_BASE_DELAY_MS=1500

# Playwright auto concurrency scaling 
AUTO_ENABLED=true
AUTO_MIN_CONCURRENCY=1
AUTO_MAX_CONCURRENCY=10
CPU_UPPER_THRESHOLD=90
CPU_LOWER_THRESHOLD=65
MEM_UPPER_THRESHOLD=90
CHECK_INTERVAL=5
COOLDOWN_SECONDS=15

# Playwright timing and login behaviour
PAGE_TIMEOUT=30000
WAIT_TIMEOUT=15000
ACTION_TIMEOUT=15000
MAX_LOGIN_ATTEMPTS=3

# Runtime artifact locations
OUTPUT_DIR="output"
APP_LOG_FILE="app.log"
STORAGE_STATE="state.json"
