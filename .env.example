# Default Application Configuration
DEBUG=false

# Authentication credentials for Playwright to use during the Amazon login flow
LOGIN_EMAIL="your_email@example.com"
LOGIN_PASSWORD="your_password"
OTP_SECRET_KEY="YOUR_2FA_SECRET_KEY"

# The login endpoint
LOGIN_URL="https://sellercentral.amazon.co.uk/ap/signin"

# The target dashboard that Playwright lands on to verify authentication
TARGET_URL="https://sellercentral.amazon.co.uk/snowdash/ref=xx_shopdash_dnav_xx"

# Google Chat Webhook URL for posting summary cards
CHAT_WEBHOOK_URL="https://chat.googleapis.com/v1/spaces/..."

# Concurrency limitations for Playwright instances
INITIAL_CONCURRENCY=5
NUM_FORM_SUBMITTERS=2

# Playwright auto concurrency scaling 
AUTO_ENABLED=true
AUTO_MIN_CONCURRENCY=1
AUTO_MAX_CONCURRENCY=10
